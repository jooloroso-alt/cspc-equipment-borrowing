<%- include('partials/header') %>
<section class="auth-card">
  <img class="auth-logo" src="/images/cspc-logo.png" alt="CSPC logo" width="96" height="96" data-fallback>
  <h1>Resend verification email</h1>
  <p class="muted">Enter the CSPC email you registered with. If it has an unverified account, we will send a new link.</p>
  <form method="post" action="/resend-verification">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label for="email">CSPC email</label>
    <input id="email" name="email" type="email" maxlength="160" required autofocus placeholder="joveras@my.cspc.edu.ph">
    <button class="btn btn-primary btn-block">Send link</button>
  </form>
  <p class="muted center"><a href="/login">Back to log in</a></p>
</section>
<%- include('partials/footer') %>